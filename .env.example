# String de conexão do Neon (painel do Neon → Connect → copiar a URL "pooled")
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Segredo usado para assinar o login (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
